    },
    {
      "id": "archive-return", "title": "守卷閣歸來", "contentKind": "fiction", "sourceIds": ["game-fiction"],
      "body": {
        "國小": "第一張觀物之頁回來了！雕龍決定陪你繼續旅行，莊周也成了你的文友。",
        "國中": "觀物之頁重新發光。雕龍加入旅程，莊周留下第一封文友尺牘。",
        "高中": "觀物之頁完成尋回，但尚待時間驗證。七日後，蝶夢回聲將檢驗理解是否穩固。"
      }
    }
